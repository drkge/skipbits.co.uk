---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { breadcrumbList } from "@/lib/schema";
import { BUSINESS, MAILTO_HREF, TEL_HREF } from "@/consts";

const trail = [
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact/" },
];

const directions =
  "https://www.google.com/maps/dir/?api=1&destination=" +
  encodeURIComponent(`${BUSINESS.address.street}, ${BUSINESS.address.locality}, ${BUSINESS.address.postalCode}`);
---

<BaseLayout
  title="Contact us"
  description={`Call ${BUSINESS.telephoneDisplay} or email ${BUSINESS.email} for skip and container part prices and availability.`}
  schema={[breadcrumbList(trail)]}
>
  <div class="border-b border-stone-200 bg-stone-50">
    <div class="wrap py-10">
      <Breadcrumbs trail={trail} />
      <h1 class="display mt-4 text-4xl sm:text-5xl">Get in touch</h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">
        For prices, availability or help finding a part, give us a call — phone is quickest. Email works too; include
        the part code and quantity and we'll come back to you.
      </p>
    </div>
  </div>

  <div class="wrap mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <a href={TEL_HREF} class="group rounded-2xl bg-ink p-8 text-white">
      <Icon name="lucide:phone" class="size-8 text-sun-400" />
      <p class="mt-6 text-sm text-stone-400">Phone (preferred)</p>
      <p class="display mt-1 text-3xl group-hover:text-sun-400">{BUSINESS.telephoneDisplay}</p>
    </a>
    <a href={MAILTO_HREF} class="group rounded-2xl border border-stone-200 p-8 hover:border-ink">
      <Icon name="lucide:mail" class="size-8 text-brand-600" />
      <p class="mt-6 text-sm text-stone-500">Email</p>
      <p class="mt-1 text-xl font-semibold break-all text-ink group-hover:text-brand-600">{BUSINESS.email}</p>
    </a>
    <div class="rounded-2xl border border-stone-200 p-8 md:col-span-2 lg:col-span-1">
      <Icon name="lucide:map-pin" class="size-8 text-brand-600" />
      <p class="mt-6 text-sm text-stone-500">Address</p>
      <address class="mt-1 not-italic text-ink">
        {BUSINESS.addressLines.map((line) => <span class="block">{line}</span>)}
      </address>
      <a href={directions} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:underline">
        Get directions
        <Icon name="lucide:arrow-up-right" class="size-4" />
      </a>
    </div>
  </div>

  <div class="wrap mt-10">
    <dl class="grid gap-x-10 gap-y-2 text-sm text-stone-600 sm:grid-cols-[auto_1fr]">
      <dt class="font-semibold text-ink">Trading name</dt>
      <dd>{BUSINESS.name}, part of <a href={BUSINESS.parent.href} class="underline hover:text-ink">{BUSINESS.legalName}</a></dd>
      <dt class="font-semibold text-ink">Company no.</dt>
      <dd>{BUSINESS.companyNumber}</dd>
      <dt class="font-semibold text-ink">VAT no.</dt>
      <dd>{BUSINESS.vatNumber}</dd>
    </dl>
  </div>
</BaseLayout>
