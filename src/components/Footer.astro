---
import { Icon } from "astro-icon/components";
import { getCategories } from "@/lib/catalog";
import { BUSINESS, GROUPS, TEL_HREF, MAILTO_HREF } from "@/consts";

const categories = await getCategories();
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-4 border-sun-400 bg-ink text-stone-300">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="display text-2xl text-white">Skip Bits</p>
      <p class="mt-3 max-w-sm">
        Skip and container parts, lids and bin spares from Lugton, Ayrshire. Get in touch for prices and availability.
      </p>
      <ul class="mt-6 space-y-3">
        <li>
          <a href={TEL_HREF} class="inline-flex items-center gap-3 font-semibold text-white hover:text-sun-400">
            <Icon name="lucide:phone" class="size-5 text-sun-400" />
            {BUSINESS.telephoneDisplay}
          </a>
        </li>
        <li>
          <a href={MAILTO_HREF} class="inline-flex items-center gap-3 hover:text-white">
            <Icon name="lucide:mail" class="size-5 text-sun-400" />
            {BUSINESS.email}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="lucide:map-pin" class="mt-0.5 size-5 shrink-0 text-sun-400" />
          <span>{BUSINESS.addressLines.slice(1).join(", ")}</span>
        </li>
      </ul>
    </div>

    {
      GROUPS.map((group) => (
        <div>
          <h2 class="eyebrow text-stone-400">{group.title}</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {categories
              .filter((category) => category.group === group.id)
              .map((category) => (
                <li>
                  <a href={category.href} class="hover:text-white">
                    {category.title}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-3 py-6 text-sm text-stone-400 md:flex-row md:items-center md:justify-between">
      <p>
        © {year} Skip Bits, part of <a href={BUSINESS.parent.href} class="underline hover:text-white">{BUSINESS.legalName}</a>.
        Company no. {BUSINESS.companyNumber} · VAT {BUSINESS.vatNumber}
      </p>
      <ul class="flex gap-5">
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
        <li><a href="/privacy/" class="hover:text-white">Privacy</a></li>
      </ul>
    </div>
  </div>
</footer>
