---
import { Icon } from "astro-icon/components";
import ProductImage from "./ProductImage.astro";
import { coverImage, type Category } from "@/lib/catalog";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const count = category.products.length;
---

<a
  href={category.href}
  class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white transition hover:border-stone-400 hover:shadow-lg hover:shadow-stone-900/5"
>
  <ProductImage
    image={coverImage(category)}
    alt=""
    sizes="(min-width: 1280px) 280px, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
    class="border-b border-stone-100"
  />
  <div class="flex flex-1 items-start justify-between gap-3 p-4">
    <div>
      <h3 class="leading-snug font-semibold group-hover:text-brand-600">{category.title}</h3>
      <p class="mt-1 text-sm text-stone-500">{count} {count === 1 ? "part" : "parts"}</p>
    </div>
    <Icon
      name="lucide:arrow-right"
      class="mt-0.5 size-5 shrink-0 text-stone-300 transition group-hover:translate-x-0.5 group-hover:text-brand-600"
    />
  </div>
</a>
