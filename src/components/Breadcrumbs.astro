---
import { Icon } from "astro-icon/components";
import type { Crumb } from "@/lib/schema";

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-stone-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      trail.map((crumb, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <Icon name="lucide:chevron-right" class="size-3.5 text-stone-300" />}
          {i === trail.length - 1 ? (
            <span aria-current="page" class="text-stone-700">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.href} class="hover:text-ink hover:underline">
              {crumb.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
