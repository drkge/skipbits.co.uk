---
// "Ask for price". Without JavaScript it's a plain mailto: link with the part
// filled in; with it, it opens the price dialog (see PriceDialog.astro).
import { Icon } from "astro-icon/components";
import { enquiryMailto } from "@/lib/enquiry";
import type { Product } from "@/lib/catalog";

interface Props {
  product: Pick<Product, "name" | "code" | "options">;
  size?: "sm" | "lg";
  class?: string;
}

const { product, size = "sm", class: className } = Astro.props;
---

<a
  href={enquiryMailto(product)}
  class:list={["btn", size === "sm" ? "btn-sm btn-sun" : "btn-primary", className]}
  data-ask
  data-name={product.name}
  data-code={product.code}
  data-option={product.options?.name}
>
  <Icon name="lucide:tag" class={size === "sm" ? "size-4" : "size-5"} />
  Ask for price
</a>
